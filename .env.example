# Copia este archivo como .env.local y rellena los valores.
# No subas .env.local al repositorio.

# URL del proyecto (Project Settings → API). No es secreta.
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave secreta (sb_secret_…) o service_role. SOLO SERVIDOR.
# Nunca la prefijes con NEXT_PUBLIC_: se incrustaría en el JavaScript del navegador.
SUPABASE_SECRET_KEY=

# Los endpoints que usan la clave secreta están bloqueados en producción
# porque la aplicación no tiene autenticación. Actívalo solo tras protegerlos.
# ETL_PERMITIR_EN_PRODUCCION=true
